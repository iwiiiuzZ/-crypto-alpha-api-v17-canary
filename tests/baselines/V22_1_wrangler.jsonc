{
  "name": "crypto-alpha-api-v17-canary",
  "main": "main-v188.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCANNER_STATE",
        "class_name": "ScannerState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v18-8-0-scanner-state",
      "new_sqlite_classes": [
        "ScannerState"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
