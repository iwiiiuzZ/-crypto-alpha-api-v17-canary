{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-alpha-api-v17-canary",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ALERTS_KV",
      "id": "f36960606aa147afab9d808408c7e3c0"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}